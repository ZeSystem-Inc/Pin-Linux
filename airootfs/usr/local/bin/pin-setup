#!/usr/bin/env bash
clear
echo "=============================================="
echo "   Pin Linux Kurulum"
echo "   Terminal açmak için: Shift + F10"
echo "=============================================="
echo

if ! ping -c1 -W3 1.1.1.1 >/dev/null 2>&1; then
    echo "İnternet bağlantısı yok. Kablosuz ağ için Shift+F10 ile terminal"
    echo "açıp 'iwctl' kullanabilirsin."
    read -rp "Devam etmek için Enter'a bas..." _
fi

archinstall
rc=$?

if [ $rc -ne 0 ]; then
    echo "Kurulum hata ile bitti (kod: $rc)."
    read -rp "Kabuğa dönmek için Enter..." _
    exit $rc
fi

# Kurulan sisteme Pin Linux kimliğini yaz (en iyi çaba)
if [ -d /mnt/etc ]; then
    cp /etc/os-release /mnt/etc/os-release 2>/dev/null
    cp /etc/issue /mnt/etc/issue 2>/dev/null
fi

read -rp "Kurulum tamamlandı. Yeniden başlatmak için Enter..." _
systemctl reboot
