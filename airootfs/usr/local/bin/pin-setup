#!/usr/bin/env bash
clear
echo "=============================================="
echo "   Pin Linux Kurulum"
echo "   Terminal açmak için: Shift + F10"
echo "=============================================="
echo

if ! ping -c1 -W3 1.1.1.1 >/dev/null 2>&1; then
    echo "İnternet bağlantısı yok. Kablosuz ağ için Shift+F10 ile terminal"
    echo "açıp 'iwctl' kullanabilirsin."
    read -rp "Devam etmek için Enter'a bas..." _
fi

archinstall
rc=$?

if [ $rc -ne 0 ]; then
    echo "Kurulum hata ile bitti (kod: $rc)."
    read -rp "Kabuğa dönmek için Enter..." _
    exit $rc
fi

# Kurulan sisteme Pin Linux kimliğini yaz (en iyi çaba)
if [ -d /mnt/etc ]; then
    # Hook'un kaynak aldığı os-release ve hook'un kendisi
    install -Dm644 /etc/os-release /mnt/usr/share/pinlinux/os-release
    install -Dm644 /usr/share/pinlinux/pinlinux-branding.hook \
        /mnt/etc/pacman.d/hooks/pinlinux-branding.hook

    # Şimdilik kimliği doğrudan uygula
    cp /etc/os-release /mnt/usr/lib/os-release
    cp /etc/issue /mnt/etc/issue
fi

read -rp "Kurulum tamamlandı. Yeniden başlatmak için Enter..." _
systemctl reboot
